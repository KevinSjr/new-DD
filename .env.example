# Copie para .env.local e preencha localmente. Nunca versione credenciais.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=COLOQUE_SUA_SENHA_AQUI
PGDATABASE=daydreaming
# Em hospedagem gerenciada você também pode usar DATABASE_URL em vez dos campos acima.
DATABASE_SSL=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=COLE_O_HASH_GERADO_POR_NPM_RUN_ADMIN_HASH
API_HOST=127.0.0.1
API_PORT=3001
# Em produção: NODE_ENV=production, PUBLIC_ORIGIN=https://seu-dominio

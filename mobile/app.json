{
  "expo": {
    "name": "Daydreaming",
    "slug": "daydreaming",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/daydreaming-icon.png",
    "scheme": "daydreaming",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FB",
        "foregroundImage": "./assets/images/daydreaming-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.nozuky.daydreaming"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/daydreaming-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FBFF",
          "image": "./assets/images/daydreaming-icon.png",
          "imageWidth": 112
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e13cb56-31df-4347-9c1d-fd66041dfacb"
      }
    },
    "owner": "nozuky"
  }
}

{
  "name": "daydreaming",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify_publish.mjs",
    "lint": "eslint .",
    "test:gpa": "node --experimental-strip-types tests/gpa.test.mjs",
    "test:destinations": "node --experimental-strip-types tests/destinationMatcher.test.mjs",
    "test:scholarships": "node tests/scholarships.test.mjs",
    "api:dev": "node --env-file=.env.local server/index.mjs",
    "api:start": "node server/index.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "data:import-iefa": "node --env-file=.env.local scripts/import_iefa.mjs",
    "data:import-scholarship-america": "node --env-file=.env.local scripts/import_scholarship_america.mjs",
    "data:verify-scholarship-america": "node --env-file=.env.local scripts/verify_scholarship_america_import.mjs",
    "data:verify-iefa": "node --env-file=.env.local scripts/verify_iefa_import.mjs",
    "admin:hash": "node scripts/hash_admin_password.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
